 "vo": [
  {
   "id": "s02.1",
   "at": 7.2,
   "text": "Seven p.m."
  },
  {
   "id": "s02.2",
   "at": 8.35,
   "text": "Your disk is full."
  },
  {
   "id": "s02.3",
   "at": 9.75,
   "text": "You need one small app."
  },
  {
   "id": "s02.4",
   "at": 11.6,
   "text": "Ten tabs."
  },
  {
   "id": "s02.5",
   "at": 12.7,
   "text": "Every review disagrees."
  },
  {
   "id": "s02.6",
   "at": 14.7,
   "text": "One wants a subscription."
  },
  {
   "id": "s02.7",
   "at": 16.25,
   "text": "One wants full disk access."
  },
  {
   "id": "s02.8",
   "at": 18.3,
   "text": "Is it even safe?"
  },
  {
   "id": "s02.9",
   "at": 19.8,
   "text": "Install four."
  },
  {
   "id": "s02.10",
   "at": 20.9,
   "text": "Delete three."
  },
  {
   "id": "s02.11",
   "at": 22.1,
   "text": "Or have AI build one,"
  },
  {
   "id": "s02.12",
   "at": 23.9,
   "text": "and maintain it forever."
  },
  {
   "id": "s02.13",
   "at": 26.0,
   "text": "Eleven forty-eight."
  },
  {
   "id": "s02.14",
   "at": 27.75,
   "text": "Still full."
  },
  {
   "id": "s03.1",
   "at": 31.0,
   "text": "Chances are, someone already built it."
  },
  {
   "id": "s03.2",
   "at": 33.8,
   "text": "pickfit finds it, and tells you what it actually tested."
  },
  {
   "id": "s04.1",
   "at": 38.4,
   "text": "Seven p.m.,"
  },
  {
   "id": "s04.2",
   "at": 39.35,
   "text": "again."
  },
  {
   "id": "s04.3",
   "at": 40.2,
   "text": "This time, just say what you need."
  },
  {
   "id": "s04.4",
   "at": 43.4,
   "text": "pickfit matches it against software it has installed and tested itself."
  },
  {
   "id": "s04.5",
   "at": 47.6,
   "text": "Ranked by fit, not stars."
  },
  {
   "id": "s04.6",
   "at": 49.75,
   "text": "No ads."
  },
  {
   "id": "s05.1",
   "at": 50.85,
   "text": "Want to see it first?"
  },
  {
   "id": "s05.2",
   "at": 52.0,
   "text": "This is pickfit using MangoDisk on a fresh macOS VM."
  },
  {
   "id": "s05.3",
   "at": 56.2,
   "text": "One chapter per feature it checked."
  },
  {
   "id": "s05.4",
   "at": 58.5,
   "text": "An AI agent did the clicking."
  },
  {
   "id": "s06.1",
   "at": 62.8,
   "text": "Hand it to your agent."
  },
  {
   "id": "s06.2",
   "at": 64.3,
   "text": "It gets the exact steps that worked in the sandbox."
  },
  {
   "id": "s06.3",
   "at": 67.6,
   "text": "It warns you about known vulnerabilities first."
  },
  {
   "id": "s06.4",
   "at": 71.2,
   "text": "And it asks before it runs anything."
  },
  {
   "id": "s07.1",
   "at": 77.0,
   "text": "Scan."
  },
  {
   "id": "s07.2",
   "at": 78.4,
   "text": "Find the big ones."
  },
  {
   "id": "s07.3",
   "at": 80.0,
   "text": "Clear them."
  },
  {
   "id": "s07.4",
   "at": 81.2,
   "text": "Your evening is back."
  },
  {
   "id": "s07.5",
   "at": 82.9,
   "text": "Then your agent tells pickfit how it went."
  },
  {
   "id": "s08.1",
   "at": 86.3,
   "text": "You're not the only one looking for software."
  },
  {
   "id": "s08.2",
   "at": 88.8,
   "text": "So is your agent."
  },
  {
   "id": "s08.3",
   "at": 91.0,
   "text": "Ask it something it has no tool for."
  },
  {
   "id": "s08.4",
   "at": 93.8,
   "text": "pickfit finds a scanner that was tested on a Mac."
  },
  {
   "id": "s08.5",
   "at": 97.0,
   "text": "Your agent asks first, then runs it."
  },
  {
   "id": "s12.1",
   "at": 101.6,
   "text": "Or it gives itself a new skill:"
  },
  {
   "id": "s12.2",
   "at": 104.08,
   "text": "a Project Gutenberg server,"
  },
  {
   "id": "s12.3",
   "at": 106.13,
   "text": "installed with your okay, then put to work."
  },
  {
   "id": "s09.1",
   "at": 109.65,
   "text": "MangoDisk's ticket existed before you asked."
  },
  {
   "id": "s09.2",
   "at": 113.1,
   "text": "It started as one submission."
  },
  {
   "id": "s09.3",
   "at": 115.3,
   "text": "An AI model made the first cut in two seconds."
  },
  {
   "id": "s09.4",
   "at": 118.9,
   "text": "Another read the README and kept the quotes."
  },
  {
   "id": "s09.5",
   "at": 122.9,
   "text": "Then, a fresh macOS VM. pickfit installed it,"
  },
  {
   "id": "s09.6",
   "at": 126.3,
   "text": "an AI agent clicked through all four features,"
  },
  {
   "id": "s09.7",
   "at": 129.0,
   "text": "and pickfit checked the results."
  },
  {
   "id": "s09.8",
   "at": 132.8,
   "text": "When it kept missing small checkboxes, we measured why,"
  },
  {
   "id": "s09.9",
   "at": 135.95,
   "text": "and taught it to zoom in and aim again."
  },
  {
   "id": "s14.1",
   "at": 138.9,
   "text": "More than a thousand tools listed."
  },
  {
   "id": "s14.2",
   "at": 141.6,
   "text": "Over seven hundred verified,"
  },
  {
   "id": "s14.3",
   "at": 143.45,
   "text": "at least through install."
  },
  {
   "id": "s14.4",
   "at": 145.2,
   "text": "The rest say so."
  },
  {
   "id": "s10.1",
   "at": 146.8,
   "text": "On the other end of the thread is the person who built it."
  },
  {
   "id": "s10.2",
   "at": 150.2,
   "text": "Makers can already submit on the website:"
  },
  {
   "id": "s10.3",
   "at": 153.4,
   "text": "paste a link, and the same tests run."
  },
  {
   "id": "s15.1",
   "at": 158.8,
   "text": "Next,"
  },
  {
   "id": "s15.2",
   "at": 159.55,
   "text": "real outcomes from agents will sharpen every match."
  },
  {
   "id": "s11.1",
   "at": 164.4,
   "text": "Ask through your agent, or on the web."
  },
  {
   "id": "s11.2",
   "at": 167.3,
   "text": "The rest of your evening is yours."
  },
  {
   "id": "s11.3",
   "at": 169.9,
   "text": "pickfit."
  },
  {
   "id": "s11.4",
   "at": 170.8,
   "text": "The right software,"
  },
  {
   "id": "s11.5",
   "at": 172.0,
   "text": "for the person who needs it."
  }
 ],
 "trim": {
  "from": 7.0,
