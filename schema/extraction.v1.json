    "ExtractedPrerequisites": {
      "additionalProperties": false,
      "description": "What must exist before installing, as the sources state it.",
      "properties": {
        "api_keys": {
          "description": "Third-party API keys or accounts the user must supply.",
          "items": {
            "$ref": "#/$defs/Cited_str_"
          },
          "type": "array"
        },
        "apple_silicon_only": {
          "$ref": "#/$defs/Cited_bool_"
        },
        "gpu": {
          "$ref": "#/$defs/Cited_Need_"
        },
        "min_ram_gb": {
          "$ref": "#/$defs/Cited_float_"
        },
        "network": {
          "$ref": "#/$defs/Cited_Need_",
          "description": "Whether it needs network access after install."
        },
        "runtimes": {
          "description": "Language runtimes, e.g. 'python>=3.10'.",
          "items": {
            "$ref": "#/$defs/Cited_str_"
          },
          "type": "array"
        },
        "system_packages": {
          "description": "OS packages, e.g. 'ffmpeg'.",
          "items": {
            "$ref": "#/$defs/Cited_str_"
          },
          "type": "array"
        }
      },
