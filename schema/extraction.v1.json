        "runtimes",
        "system_packages",
        "gpu",
        "apple_silicon_only",
        "min_ram_gb",
        "network",
        "api_keys"
      ],
      "title": "ExtractedPrerequisites",
      "type": "object"
    },
    "InstallClaim": {
      "additionalProperties": false,
      "description": "An install command as the sources state it; not run yet.",
      "properties": {
        "command": {
          "description": "Copied verbatim; it is its own quote.",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/InstallMethod"
        },
        "platforms": {
          "description": "Platforms the source names for this command; empty when it names none. brew alone does not mean macOS only.",
          "items": {
            "$ref": "#/$defs/OS"
          },
          "type": "array"
        }
      },
      "required": [
        "method",
        "command",
        "platforms"
      ],
      "title": "InstallClaim",
      "type": "object"
    },
