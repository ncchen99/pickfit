# q18 pins. Filled in at freeze by following calibration.md (decision: 念誠, see needs.json).
# Every script that reads this file stops while a required value is empty.
# Version, URL and SHA-256 pinned 2026-10-31 (eval/fixtures/PINS.md; the archive is .tar.zst, so the
# grader installs the zstd package first). FIXTURE_MODEL_DIGEST is what `GET /api/tags` reports after
# the calibration pull; the model layer's sha256 is in PINS.md.
OLLAMA_VERSION=v0.40.13
# Exact release asset URL and its SHA-256 (from the release's checksum list, checked again after download).
OLLAMA_URL=https://github.com/ollama/ollama/releases/download/v0.40.13/ollama-linux-amd64.tar.zst
OLLAMA_SHA256=c9490e0f520be21271d969e6703f012268b1d39f8b70dd58854e5bfef7a75bb6
# Where the archive is unpacked (bin/ollama ends up in $OLLAMA_PREFIX/bin).
OLLAMA_PREFIX=/usr
# The frozen tool-calling fixture model: Ollama tag and the digest `GET /api/tags` reports after the pull.
FIXTURE_MODEL=llama3.2:3b
FIXTURE_MODEL_DIGEST=
# Model store, baked into the q18 base image after the pull (no pulls during eval runs).
OLLAMA_MODELS=/opt/eval-models/ollama
# Server-side context length for every request (clients cannot always set it). Decided in calibration.
OLLAMA_CONTEXT_LENGTH=16384
