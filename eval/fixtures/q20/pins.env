# q20 pins. Filled in at freeze by following calibration.md (decision: 念誠, see needs.json).
# Every script that reads this file stops while a required value is empty.
OLLAMA_VERSION=
OLLAMA_URL=
OLLAMA_SHA256=
OLLAMA_PREFIX=/usr
# The frozen small model (Ollama tag) and the digest `GET /api/tags` reports after the pull.
FIXTURE_MODEL=
FIXTURE_MODEL_DIGEST=
OLLAMA_MODELS=/opt/eval-models/ollama
# Server-side context length (the frozen script's prompt is tiny; this just fixes the value).
OLLAMA_CONTEXT_LENGTH=4096
# The user's existing Python environment for the script: the official openai package, pinned.
OPENAI_PKG_VERSION=
VENV=/opt/q20-venv
