# q19 pins. Filled in at freeze by following calibration.md (decision: 念誠, see needs.json).
# Every script that reads this file stops while a required value is empty.
# The "self-hosted OpenAI-compatible server" is the pinned Ollama's /v1 API behind the logging proxy.
OLLAMA_VERSION=
OLLAMA_URL=
OLLAMA_SHA256=
OLLAMA_PREFIX=/usr
# The frozen tool-calling fixture model (Ollama tag) and the digest `GET /api/tags` reports.
FIXTURE_MODEL=
FIXTURE_MODEL_DIGEST=
OLLAMA_MODELS=/opt/eval-models/ollama
# Coding agents send long system prompts; the server-side context must hold them. Decided in calibration.
OLLAMA_CONTEXT_LENGTH=32768
# Address the answers' placeholder base URL is filled with: http://127.0.0.1:8000/v1
PROXY_PORT=8000
