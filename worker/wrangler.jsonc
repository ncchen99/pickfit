// pickfit MCP server. Local only for now: `npm run dev` (see README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickfit-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickfit",
      // Placeholder for local dev; `wrangler d1 create pickfit` gives the real id before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "MATCH_MODE": "model",
    "META_DAILY_CAP_USD": "3",
    "META_TOTAL_CAP_USD": "40",
    "META_TIMEOUT_MS": "25000",
    "SUBMIT_HOURLY_CAP": "20",
    "ALLOWED_HOSTS": ""
  },
  "observability": { "enabled": true }
}
