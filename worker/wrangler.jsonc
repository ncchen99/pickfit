// pickfit MCP server: https://pickfit.app/mcp (also https://pickfit-mcp.ncchen99.workers.dev/mcp). Local: `npm run dev` (see README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickfit-mcp",
  "main": "src/index.ts",
  // The web page's static files: Fitz (copied from brand/mascot by `npm run sync:assets`) and the font.
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-10-01",
  // pickfit.app (bought 11/2, zone on this Cloudflare account); workers.dev stays on for existing MCP clients.
  "routes": [{ "pattern": "pickfit.app", "custom_domain": true }],
  // Declaring routes turns workers.dev off unless it is set explicitly.
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickfit",
      // Created with `wrangler d1 create pickfit` (10/29).
      "database_id": "4ecf04a8-9a23-4b2f-aee7-288251836975",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "MATCH_MODE": "model",
    "META_DAILY_CAP_USD": "3",
    "META_TOTAL_CAP_USD": "15",
    "META_TIMEOUT_MS": "25000",
    "SUBMIT_HOURLY_CAP": "20",
    "TOOLS": "all",
    "ALLOWED_HOSTS": "pickfit.app,pickfit-mcp.ncchen99.workers.dev",
    // The product web page (src/web.ts): it stops calling Meta at $2 of the $3 daily cap, leaving $1 for agents.
    "WEB_SEARCH": "on",
    "WEB_DAILY_CAP_USD": "2"
  },
  // Web searches per visitor per minute (src/web.ts SEARCHES_PER_MINUTE); counted per Cloudflare location.
  "ratelimits": [
    { "name": "WEB_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ],
  // Verification clips (src/video.ts): <slug>/<file> in pickfit-videos (APAC). Not inherited by the env sections.
  "r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "pickfit-videos" }],
  "observability": { "enabled": true },
  // Evaluation deployments: same code, same bundled data, settings only.
  // `uv run pickfit publish --env <name>`; do not publish an env again while
  // its evaluation runs (that is what keeps it frozen). Each has its own D1,
  // so its events and Meta budget stay apart from the public server's.
  // vars and d1_databases are not inherited from the top level.
  "env": {
    // The pickfit arm: read-only tools, muse-spark-1.3 matching.
    "eval": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pickfit-eval",
          // Created with `wrangler d1 create pickfit-eval` (11/2).
          "database_id": "d6ce7bcd-5cf7-4f9d-b8f7-38308a96a476",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TOOLS": "readonly",
        "MATCH_MODE": "model",
        "META_DAILY_CAP_USD": "10",
        "META_TOTAL_CAP_USD": "10",
        "META_TIMEOUT_MS": "25000",
        "SUBMIT_HOURLY_CAP": "0",
        "ALLOWED_HOSTS": "pickfit-mcp-eval.ncchen99.workers.dev",
        // No web page: an evaluation deployment serves /mcp and the JSON health check only.
        "WEB_SEARCH": "off",
        "WEB_DAILY_CAP_USD": "0"
      },
      // Unused while WEB_SEARCH is off; listed because wrangler does not inherit ratelimits into an env.
      // Its own namespace, so no counter is shared with the public server or the other arm.
      "ratelimits": [
        { "name": "WEB_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }
      ],
      // routes are inherited from the top level; this keeps pickfit.app on the public server only.
      "routes": []
    },
    // The rules-only arm: same tools and data, no model call (caps at 0 as a second guard).
    "eval-rules": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pickfit-eval-rules",
          // Created with `wrangler d1 create pickfit-eval-rules` (11/2).
          "database_id": "30e5a982-287b-4ed6-b3ed-45d097810cd7",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TOOLS": "readonly",
        "MATCH_MODE": "off",
        "META_DAILY_CAP_USD": "0",
        "META_TOTAL_CAP_USD": "0",
        "META_TIMEOUT_MS": "25000",
        "SUBMIT_HOURLY_CAP": "0",
        "ALLOWED_HOSTS": "pickfit-mcp-eval-rules.ncchen99.workers.dev",
        // No web page: an evaluation deployment serves /mcp and the JSON health check only.
        "WEB_SEARCH": "off",
        "WEB_DAILY_CAP_USD": "0"
      },
      // Unused while WEB_SEARCH is off; listed because wrangler does not inherit ratelimits into an env.
      // Its own namespace, so no counter is shared with the public server or the other arm.
      "ratelimits": [
        { "name": "WEB_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } }
      ],
      // routes are inherited from the top level; this keeps pickfit.app on the public server only.
      "routes": []
    }
  }
}
