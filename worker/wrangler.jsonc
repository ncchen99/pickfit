// pickfit MCP server: https://pickfit-mcp.ncchen99.workers.dev/mcp. Local: `npm run dev` (see README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickfit-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickfit",
      // Created with `wrangler d1 create pickfit` (10/29).
      "database_id": "4ecf04a8-9a23-4b2f-aee7-288251836975",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "MATCH_MODE": "model",
    "META_DAILY_CAP_USD": "3",
    "META_TOTAL_CAP_USD": "40",
    "META_TIMEOUT_MS": "25000",
    "SUBMIT_HOURLY_CAP": "20",
    "TOOLS": "all",
    "ALLOWED_HOSTS": "pickfit-mcp.ncchen99.workers.dev",
    // The product web page (src/web.ts): it stops calling Meta at $2 of the $3 daily cap, leaving $1 for agents.
    "WEB_SEARCH": "on",
    "WEB_DAILY_CAP_USD": "2"
  },
  // Web searches per visitor per minute (src/web.ts SEARCHES_PER_MINUTE); counted per Cloudflare location.
  "ratelimits": [
    { "name": "WEB_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // Evaluation deployments: same code, same bundled data, settings only.
  // `uv run pickfit publish --env <name>`; do not publish an env again while
  // its evaluation runs (that is what keeps it frozen). Each has its own D1,
  // so its events and Meta budget stay apart from the public server's.
  // vars and d1_databases are not inherited from the top level.
  "env": {
    // The pickfit arm: read-only tools, muse-spark-1.3 matching.
    "eval": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pickfit-eval",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TOOLS": "readonly",
        "MATCH_MODE": "model",
        "META_DAILY_CAP_USD": "10",
        "META_TOTAL_CAP_USD": "10",
        "META_TIMEOUT_MS": "25000",
        "SUBMIT_HOURLY_CAP": "0",
        "ALLOWED_HOSTS": "",
        // No web page: an evaluation deployment serves /mcp and the JSON health check only.
        "WEB_SEARCH": "off"
      }
    },
    // The rules-only arm: same tools and data, no model call (caps at 0 as a second guard).
    "eval-rules": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pickfit-eval-rules",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TOOLS": "readonly",
        "MATCH_MODE": "off",
        "META_DAILY_CAP_USD": "0",
        "META_TOTAL_CAP_USD": "0",
        "META_TIMEOUT_MS": "25000",
        "SUBMIT_HOURLY_CAP": "0",
        "ALLOWED_HOSTS": "",
        // No web page: an evaluation deployment serves /mcp and the JSON health check only.
        "WEB_SEARCH": "off"
      }
    }
  }
}
