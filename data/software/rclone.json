    "features": [
      {
        "feature": "sync directories one way with cloud storage",
        "title": "Sync a directory one way to another location",
        "steps": [
          "Run `rclone sync <source> <destination> -v` to make the destination match the source.",
          "Run `rclone check <source> <destination>` to confirm there are no differences.",
          "Run `rclone ls <destination>` to list the synced files."
        ]
      },
      {
        "feature": "two-way bidirectional sync",
        "title": "Keep two directories in sync both ways",
        "steps": [
          "Run `rclone bisync <path1> <path2> --resync --workdir <workdir> -v` once to set up the pair.",
          "After changing files on either side, run `rclone bisync <path1> <path2> --workdir <workdir> -v`.",
          "Run `rclone ls <path2>` to see the result."
        ]
      },
      {
        "feature": "mount remote storage via FUSE",
        "title": "Mount remote storage as a local folder",
        "steps": []
      },
      {
        "feature": "encrypt files on remotes",
        "title": "Encrypt files stored on a remote",
        "steps": [
          "Run `rclone copy <source> \":crypt,remote=<folder>,password=$(rclone obscure <password>):\" -v` to store encrypted copies.",
          "Run `rclone cat \":crypt,remote=<folder>,password=$(rclone obscure <password>):<file>\"` to read a file back decrypted."
        ]
      }
    ]
