          "purpose": "Download SHA256 checksum"
        },
        {
          "command": "mkdir -p ~/Applications && mkdir -p /tmp/camelid-mount2 && hdiutil attach -nobrowse -mountpoint /tmp/camelid-mount2 /tmp/camelid-desktop-macos-arm64.dmg -quiet",
          "purpose": "Mount DMG"
        },
        {
          "command": "cp -R /tmp/camelid-mount2/\"Camelid Desktop.app\" ~/Applications/ && hdiutil detach /tmp/camelid-mount2 -quiet",
          "purpose": "Copy app to ~/Applications and detach"
        },
        {
          "command": "xattr -cr ~/Applications/\"Camelid Desktop.app\" && codesign --verify --deep --strict ~/Applications/\"Camelid Desktop.app\"",
          "purpose": "Clear quarantine and verify codesign"
        }
      ],
      "manual_steps": [],
