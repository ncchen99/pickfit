          {
            "readme_said": "uv tool install gui-agent",
            "actually_needed": "PyPI package gui-agent 0.0.1 provides no executables; must install from git source instead",
            "kind": "readme_wrong"
          },
          {
            "readme_said": "uv tool install git+https://github.com/leandre755/gui_agent.git",
            "actually_needed": "remove the evdev>=1.7.0 line from pyproject.toml before install because evdev builds from source and needs kernel headers (linux/input.h) not present and not installable without root",
