        "pitfalls": [
          {
            "readme_said": "wget -O whisper.sh https://github.com/hwdsl2/whisper-install/raw/main/whisper-install.sh",
            "actually_needed": "used curl -fL -o whisper.sh <url> because wget is not on PATH in this box",
            "kind": "sandbox"
          },
          {
            "readme_said": "sudo bash whisper.sh --help / --listmodels / --showinfo management examples",
            "actually_needed": "check_root runs before parse_args, so even read-only actions --help and --listmodels exit 1 with 'This installer must be run as root' when not root; sudo is not available (uid 1000, no sudo binary)",
            "kind": "note"
          },
          {
            "readme_said": "sudo bash whisper.sh --auto installs system packages, venv, config and systemd service",
            "actually_needed": "installer fetches whisper_api_server.py from https://github.com/hwdsl2/ai-stack-extras/releases/download/v1.0.0/whisper_api_server.py at install time with SHA256 verification; writes to /opt/whisper, /etc/whisper, /var/lib/whisper and uses apt/yum plus systemctl, all requiring root",
            "kind": "note"
          }
        ],
