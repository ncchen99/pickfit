check=1\" % uuid)\nprint(\"second snapshot:\", wait_history(2))\nfor _ in range(60):\n    if state[\"notified\"]: break\n    time.sleep(1)\nif not state[\"notified\"]:\n    raise SystemExit(\"NO NOTIFICATION RECEIVED\")\nprint(\"NOTIFICATION RECEIVED\")\nprint(state[\"notified\"][0][:800])\nEOF",
