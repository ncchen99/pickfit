        "steps": [
          "Start the server with `./runner -m <model.gguf> --serve --port 8080`.",
          "Send a chat request with `curl -s http://127.0.0.1:8080/v1/chat/completions -H 'Content-Type: application/json' -d '{\"messages\":[{\"role\":\"user\",\"content\":\"<your text>\"}],\"temperature\":0,\"max_tokens\":1"
        ]
      },
      {
        "feature": "train LoRA through quantized weights",
        "title": "Train a LoRA adapter through quantized weights",
        "steps": [
          "Write training examples to a JSONL file, one {\"prompt\": ..., \"completion\": ...} object per line.",
          "Run `./runner train <data.jsonl> -m <model.gguf> --steps 2 --lora-rank 4 --out <adapter.gguf>`."
        ]
      },
      {
        "feature": "complete tool calls past token limit",
        "title": "Finish tool calls past the token limit",
        "steps": []
      },
      {
        "feature": "replay runs as signed receipts",
        "title": "Record a run as a signed receipt and replay it",
        "steps": [
          "Record a run with `./runner -m <model.gguf> -p \"<your text>\" -s 42 --record <receipt.json>`.",
          "Check it with `./runner -m <model.gguf> --verify <receipt.json>` and look for VERIFIED."
        ]
      }
    ]
