    "features": [
      {
        "feature": "create, revoke, validate and bundle X.509 certificates",
        "title": "Create, revoke, check and bundle X.509 certificates",
        "steps": [
          "Create a root CA with `step certificate create \"<root name>\" root.crt root.key --profile root-ca --no-password --insecure -f`, then a leaf with `step certificate create <hostname> leaf.crt leaf.key --",
          "Check the leaf against the root with `step certificate verify leaf.crt --roots root.crt`.",
          "Bundle the certificates with `step certificate bundle leaf.crt root.crt bundle.crt` and view one with `step certificate inspect leaf.crt --short`."
        ]
      },
      {
        "feature": "administer and use a step-ca or ACME CA",
        "title": "Run and use a step-ca or ACME certificate authority",
        "steps": [
          "Set up a new CA with `step ca init --ssh --name <CA name> --dns <hostname> --address <ip:port> --provisioner <email> --password-file <file> --deployment-type standalone`.",
          "Look for the message \"Your PKI is ready to go.\"",
          "Run `step help ca` to see how to issue certificates for your services."
        ]
      },
      {
        "feature": "work with JWTs and JOSE constructs",
        "title": "Work with JWTs and JOSE objects",
        "steps": [
          "Create a key pair with `step crypto jwk create pub.json priv.json --kty EC --no-password --insecure -f`.",
          "Sign a token with `step crypto jwt sign --key priv.json --iss <issuer> --aud <audience> --sub <subject> --exp <unix time> < /dev/null > <file>`.",
          "Verify it with `step crypto jwt verify --key pub.json --iss <issuer> --aud <audience> < <file>`."
        ]
      },
      {
        "feature": "create and manage SSH certificates",
        "title": "Create and manage SSH certificates",
