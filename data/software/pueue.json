    "open_hint": "Start the background daemon with `pueued`, then queue a command with `pueue add '<your command>'`.",
    "features": [
      {
        "feature": "queue tasks and run them in parallel",
        "title": "Queue tasks and run several at once",
        "steps": [
          "Start the daemon with `pueued -v`.",
          "Set how many tasks run at once with `pueue parallel <number>`.",
          "Queue commands with `pueue add '<your command>'`, then check them with `pueue status` and `pueue wait`."
        ]
      },
      {
        "feature": "specify dependencies between tasks",
        "title": "Make a task wait for another task",
        "steps": [
          "Queue the first task and get its ID with `pueue add -p '<your command>'`.",
          "Queue a dependent task with `pueue add -p --after <task id> -- '<your command>'`.",
          "Check progress with `pueue status` and see its output with `pueue log <task id>`."
        ]
      },
      {
        "feature": "inspect output and send input to tasks",
        "title": "View task output and send input to tasks",
        "steps": [
          "Queue a task that reads input with `pueue add -p '<your command>'`.",
          "Send it input with `pueue send <task id> '<your text>'`.",
          "See its output with `pueue log <task id>`."
        ]
      },
      {
        "feature": "organize tasks into groups with separate queues",
        "title": "Sort tasks into groups with their own queues",
        "steps": [
          "Create a group with `pueue group add <group name>` and set its limit with `pueue parallel -g <group name> <number>`.",
          "Add a task to it with `pueue add -p -g <group name> '<your command>'`.",
          "Check the group with `pueue status -g <group name>` and list groups with `pueue group`."
        ]
      }
    ]
