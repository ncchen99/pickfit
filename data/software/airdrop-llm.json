        "pitfalls": [
          {
            "readme_said": "airdrop start spawns model and daemon directly",
            "actually_needed": "CLI wrapper `airdrop start` tries to spawn `ollama serve` and crashes with ENOENT if ollama not installed; running daemon directly via `node bin/airdrop-daemon --mode master` bypasses that and still exposes gateway on :9995",
            "kind": "readme_wrong"
          },
          {
            "readme_said": "npm install downloads Rust binary via postinstall",
            "actually_needed": "postinstall attempts GitHub binary download; on this Linux x64 box binary was a 57K Node.js shim not Rust binary, fallback to Node daemon works without Rust toolchain",
            "kind": "note"
          }
        ],
