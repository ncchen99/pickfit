          "quote": "*env* `PLAYWRIGHT_MCP_ALLOWED_HOSTS`"
        },
        "troubleshooting_uninstall": {
          "score": 1,
          "quote": "A persistent profile can only be used by one browser instance at a time, so concurrent MCP clients sharing the same workspace will conflict."
        },
        "license_and_platforms": {
          "score": 1,
          "quote": "browser or chrome channel to use, possible values: chrome, firefox, webkit, msedge."
