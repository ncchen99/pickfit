        "what_it_does": {
          "score": 2,
          "quote": "A Model Context Protocol (MCP) server that provides browser automation capabilities using [Playwright](https://playwright.dev)."
        },
        "who_it_is_for": {
          "score": 2,
          "quote": "such as exploratory automation, self-healing tests, or long-running autonomous workflows where maintaining continuous browser context outweighs token cost concerns."
        },
        "prerequisites": {
          "score": 2,
          "quote": "### Requirements\n- Node.js 18 or newer\n- VS Code, Cursor, Windsurf, Claude Desktop, Goose, Grok, Junie or any other MCP client"
        },
        "install_per_os": {
          "score": 2,
          "quote": "npx @playwright/mcp@latest"
        },
        "first_run_example": {
          "score": 1,
          "quote": "npx @playwright/mcp@latest --config path/to/config.json"
        },
        "config_and_keys": {
