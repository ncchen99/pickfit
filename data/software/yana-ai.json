  "install": {
    "macos": {
      "basis": "replayed",
      "run_id": "verify-yana-ai-20261101-230211-777c",
      "method": "uv",
      "steps": [
        {
          "command": "uv tool install yana-ai 2>&1",
          "purpose": "Install yana-ai CLI via uv tool (isolated pip install)"
        },
        {
          "command": "curl -fL -o ~/Downloads/Yana-Studio.dmg https://github.com/yanacuti1121/Yana-AI/releases/download/studio-v1.7.0/Yana-Studio-IDE-1.7.0-mac-arm64.dmg 2>&1",
          "purpose": "Download Yana Studio DMG from GitHub releases"
        },
        {
          "command": "mkdir -p ~/mnt/yana ~/Applications && hdiutil attach -nobrowse -mountpoint ~/mnt/yana ~/Downloads/Yana-Studio.dmg 2>&1 && ls -la ~/mnt/yana 2>&1 && cp -R ~/mnt/yana/*.app ~/Applications/ 2>&1 && ls -la ~/Applications/ 2>&1 && hdiutil detach -force ~/mnt/yana 2>&1",
          "purpose": "Mount DMG and copy Yana Studio.app to ~/Applications"
        },
        {
          "command": "xattr -l ~/Applications/Yana\\ Studio.app 2>&1; echo \"---xattr check done---\"; xattr -dr com.apple.quarantine ~/Applications/Yana\\ Studio.app 2>&1",
          "purpose": "Remove Gatekeeper quarantine (ad-hoc signed, not notarized)"
        }
      ],
      "manual_steps": [],
      "check": {
        "command": "yana-ai --version 2>&1",
        "expected_signal": "yana-ai 1.5.0"
      },
      "first_task": "open ~/Applications/Yana\\ Studio.app"
    },
