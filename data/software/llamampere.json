          "score": 2,
          "quote": "llamAmpere is a fast version of llama.cpp (the open-source program that runs AI language models on your own computer),"
        },
        "who_it_is_for": {
          "score": 1,
          "quote": "tuned for NVIDIA RTX 30-series \"Ampere\" graphics cards, especially the RTX 3090 and 3090 Ti."
        },
        "prerequisites": {
          "score": 2,
          "quote": "Needs Linux, an NVIDIA card with 24 GB, the\nCUDA toolkit (tested with 12.4), CMake, git and a C++ compiler."
        },
        "install_per_os": {
          "score": 1,
          "quote": "git clone -b v0.6.1 https://github.com/JakeATX/llamAmpere.git"
        },
        "first_run_example": {
          "score": 2,
          "quote": "The server listens on http://127.0.0.1:8080 (OpenAI-compatible API)."
        },
        "config_and_keys": {
          "score": 1,
          "quote": "with `--kv-gpu-tokens N` to keep only part of the context memory on the card."
        },
        "troubleshooting_uninstall": {
          "score": 0,
          "quote": null
        },
