      "items": {
        "what_it_does": {
          "score": 2,
          "quote": "**engine-mlx** is a small, honest LLM inference engine for **Apple Silicon**,\nwritten in **Rust** on top of Apple's [MLX](https://github.com/ml-explore/mlx)"
        },
        "who_it_is_for": {
          "score": 1,
          "quote": "so any OpenAI client,\nagent, or harness can talk to it locally."
        },
        "prerequisites": {
          "score": 2,
          "quote": "- **macOS on Apple Silicon** (M-series).\n- The MLX C API: `brew install mlx-c`.\n- Rust (`cargo`) to build."
        },
        "install_per_os": {
          "score": 2,
          "quote": "brew install mlx-c"
        },
        "first_run_example": {
          "score": 2,
          "quote": "cargo run --release --features mlx -p engine-mlx-serve -- \\\n  --model /path/to/Qwen3-1.7B-MLX-4bit\n#    → serves http://127.0.0.1:11435"
        },
        "config_and_keys": {
          "score": 2,
          "quote": "Override\nthe search root with the `ENGINE_MLX_MODELS_DIR` environment variable."
        },
