    "features": [
      {
        "feature": "merge log files by time into one view",
        "title": "Merge log files into one time-ordered view",
        "steps": [
          "Run `lnav -n <file1> <file2>` to print the lines of both files merged in time order."
        ]
      },
      {
        "feature": "jump to previous/next error",
        "title": "Jump to the previous or next error",
        "steps": [
          "Run `lnav -n -c ':goto 0' -c ':next-mark error' -c ':write-screen-to -' <file1> <file2>` to jump from the top to the next error line and print the screen."
        ]
      },
      {
        "feature": "filter messages with regex or SQLite",
        "title": "Filter messages with a regex or SQLite",
        "steps": [
          "Run `lnav -n -c ':filter-in <pattern>' <file1> <file2>` to show only lines that match the pattern."
        ]
      },
      {
        "feature": "analyze log messages with SQL queries",
        "title": "Analyze log messages with SQL queries",
        "steps": [
          "Run `lnav -n -c ';SELECT log_hostname, count(*) AS n FROM syslog_log WHERE log_level = '\"'\"'error'\"'\"' GROUP BY log_hostname' <file1> <file2>` to count errors per host.",
          "Start the command with `;` followed by your SQL query against the log tables."
        ]
      }
    ]
