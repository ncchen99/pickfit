        "pitfalls": [
          {
            "readme_said": "dsh plugin add dsh-novel-writer / dsh plugin add github:siweina/dsh-novel-writer#main",
            "actually_needed": "dsh CLI is not installed in the box, so `dsh plugin add ...` cannot run; installed the npm package globally with `npm install -g dsh-novel-writer` which provides `dsh-novel-writer-mcp` on PATH (~/.local/bin)"
          },
          {
            "readme_said": "command supports --version or --help",
            "actually_needed": "binary supports neither --version nor --help; any flag is ignored and the stdio MCP server starts and waits on stdin (a bare --help hangs). Used `npm list -g dsh-novel-writer` to show version 6.9.0 and MCP initialize to show serverInfo version."
          },
          {
            "readme_said": "--root /你的小说库路径",
            "actually_needed": "library root must contain a `novels/` subdirectory: <root>/novels/<book>/第01章.md; placing the book directly under --root returns empty library"
          },
          {
            "readme_said": "novel_read reading a chapter",
            "actually_needed": "novel_read `chapter` must be a string (e.g. \"1\" or \"第01章\"); passing a JSON number 1 fails with 参数 \"chapter\" 不能为空字符串"
          }
        ],
