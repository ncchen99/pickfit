        "pitfalls": [
          {
            "readme_said": "pnpm run build:portable compiles executable at src-tauri/target/release/",
            "actually_needed": "Requires Rust stable, pnpm 9, JDK 21 + Maven 3.9 and Tauri system deps (libwebkit2gtk-4.1-dev, libayatana-appindicator3-dev, librsvg2-dev, patchelf, etc.) plus no Linux release artifact (only macOS universal.app.tar.gz/dmg and Windows x64-setup.exe)",
            "kind": "note"
          },
          {
            "readme_said": "MCP server launched from desktop UI (MCP service page)",
            "actually_needed": "No headless stdio or standalone npm/pip package; MCP is HTTP server embedded in Tauri GUI (src-tauri/src/mcp.rs uses axum on 127.0.0.1), needs GUI window and cannot be probed without full desktop runtime",
            "kind": "note"
          }
        ],
