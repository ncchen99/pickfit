      "items": {
        "what_it_does": {
          "score": 2,
          "quote": "Dozzle is a lightweight, web-based application for monitoring Docker logs in real time. It doesn't store any log files—it's designed purely for live log viewing."
        },
        "who_it_is_for": {
          "score": 1,
          "quote": "Dozzle has been tested with hundreds of containers. However, it doesn't support offline searching."
        },
        "prerequisites": {
          "score": 2,
          "quote": "Dozzle requires Docker Engine 19.03 or newer (API version 1.40+). Older daemons are not supported by the underlying Docker SDK."
        },
        "install_per_os": {
          "score": 2,
          "quote": "docker run --name dozzle -d --volume=/var/run/docker.sock:/var/run/docker.sock -v dozzle_data:/data -p 8080:8080 amir20/dozzle:latest"
        },
        "first_run_example": {
          "score": 2,
          "quote": "Dozzle will be available at [http://localhost:8080/](http://localhost:8080/)."
        },
        "config_and_keys": {
          "score": 1,
          "quote": "Configuration can be done via CLI flags or environment variables."
        },
        "troubleshooting_uninstall": {
          "score": 1,
          "quote": "- **Nothing shows up at localhost:3100** — make sure Docker is running and the socket is accessible at `/var/run/docker.sock`."
        },
        "license_and_platforms": {
          "score": 2,
