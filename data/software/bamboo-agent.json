        "pitfalls": [
          {
            "readme_said": "Standalone Bamboo: cargo install bamboo-agent --locked; bamboo --help",
            "actually_needed": "~/.cargo/bin must be on PATH (the box's PATH did not include it); the install itself worked with the box's Rust toolchain and took about 18 minutes.",
            "kind": "note"
          },
          {
            "readme_said": "Bodhi desktop app: curl ... install.sh | sh (terminal installer)",
            "actually_needed": "The script installs a different product (Bodhi-AI desktop, a .deb) with sudo apt-get and needs a terminal for the sudo prompt. It cannot run without root, so it was not used; the Bamboo CLI came from cargo.",
            "kind": "note"
          },
          {
            "readme_said": "bamboo init (interactive provider setup) then bamboo serve",
            "actually_needed": "bamboo serve starts without init. Headless runs need a provider key, which was not available, so bamboo -p failed with HTTP 500 and doctor reported no config.json and no anthropic API key.",
            "kind": "note"
          },
          {
            "readme_said": "bamboo -p \"Summarize the README in this workspace.\" --workspace /path/to/project",
            "actually_needed": "Needs a configured model provider API key; without it the run fails with 'execute rejected: HTTP 500'.",
