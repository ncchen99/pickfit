  "mcp": {
    "transports": [
      "sse",
      "stdio"
    ],
    "launch_command": "uvx postgres-mcp --access-mode=unrestricted",
    "client_configs": [
      {
        "client": "claude_desktop",
        "snippet": "{\n  \"mcpServers\": {\n    \"postgres\": {\n      \"command\": \"uvx\",\n      \"args\": [\n        \"postgres-mcp\",\n        \"--access-mode=unrestricted\"\n      ],\n      \"env\": {\n        \"DATABASE_URI\": \"postgresql://username:password@localhost:5432/dbname\"\n      }\n    }\n  }\n}"
      },
      {
        "client": "claude_desktop",
        "snippet": "{\n  \"mcpServers\": {\n    \"postgres\": {\n      \"command\": \"docker\",\n      \"args\": [\n        \"run\",\n        \"-i\",\n        \"--rm\",\n        \"-e\",\n        \"DATABASE_URI\",\n        \"crystaldba/postgres-mcp\",\n        \"--access-mode=unrestricted\"\n      ],\n      \"env\": {\n        \"DATABASE_URI\": \"postgresql://username:password@localhost:5432/dbname\"\n      }\n    }\n  }\n}"
      },
      {
        "client": "cursor",
        "snippet": "{\n    \"mcpServers\": {\n        \"postgres\": {\n            \"type\": \"sse\",\n            \"url\": \"http://localhost:8000/sse\"\n        }\n    }\n}"
      }
    ],
    "env_vars": [
      {
        "name": "DATABASE_URI",
        "required": true,
        "purpose": "Postgres connection URI"
      },
      {
        "name": "OPENAI_API_KEY",
        "required": false,
        "purpose": "OpenAI key for LLM index tuning"
      }
    ],
    "tools": [
      "list_schemas",
      "list_objects",
      "get_object_details",
