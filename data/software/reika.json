                "command": "mkdir -p /tmp/mock /tmp/proj && cat > /tmp/mock/server.py <<'PY'\nimport json\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nclass H(BaseHTTPRequestHandler):\n    def log_message(self, *a): pass\n    def do_GET(self):\n        if self.path.endswith(\"/models\"):\n            body = json.dumps({\"data\":[{\"id\":\"test-model\",\"max_model_len\":32768}]}).encode()\n            self.send_response(200); self.send_header(\"Content-Type\",\"application/json\"); self.send_header(\"Content-Length\",str(len(body))); self.end_headers(); self.wfile.write(body)\n        else:\n            self.send_response(404); self.end_headers()\n    def do_POST(self):\n        length = int(self.headers.get(\"Content-Length\",\"0\"))\n        raw = self.rfile.read(length) if length else b\"{}\"\n        try: req = json.loads(raw)\n        except: req = {}\n        print(\"REQUEST:\", json.dumps(req)[:2000], flush=True)\n        stream = req.get(\"stream\", False)\n        model = req.get(\"model\",\"test-model\")\n        text = \"Hello from mock model. Reika headless test succeeded.\"\n        if stream:\n            chunks = [\n                {\"id\":\"chatcmpl-mock\",\"object\":\"chat.completion.chunk\",\"created\":1,\"model\":model,\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"\"},\"finish_reason\":None}]},\n                {\"id\":\"chatcmpl-mock\",\"object\":\"chat.completion.chunk\",\"created\":1,\"model\":model,\"choices\":[{\"index\":0,\"delta\":{\"content\":text},\"finish_reason\":None}]},\n                {\"id\":\"chatcmpl-mock\",\"object\":\"chat.completion.chunk\",\"created\":1,\"model\":model,\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":12,\"total_tokens\":22}},\n            ]\n            self.send_response(200); self.send_header(\"Content-Type\",\"text/event-stream\"); self.send_header(\"Cache-Control\",\"no-cache\"); self.send_header(\"Connection\",\"close\"); self.end_headers()\n            for c in chunks:\n                line = \"data: \" + json.dumps(c) + \"\\n\\n\"\n                self.wfile.write(line.encode()); self.wfile.flush()\n            self.wfile.write(b\"data: [DONE]\\n\\n\"); self.wfile.flush()\n        else:\n            body = json.dumps({\"id\":\"chatcmpl-mock\",\"object\":\"chat.completion\",\"created\":1,\"model\":model,\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":text},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":12,\"total_tokens\":22}}).encode()\n            self.send_response(200); self.send_header(\"Content-Type\",\"application/json\"); self.send_header(\"Content-Length\",str(len(body))); self.end_headers(); self.wfile.write(body)\nHTTPServer((\"127.0.0.1\",9931),H).serve_forever()\nPY\ncat /tmp/mock/server.py && echo OK && mkdir -p /tmp/proj && echo \"hello\" > /tmp/proj/notes.txt && ls -la /tmp/proj/",
