        "pitfalls": [
          {
            "readme_said": "Installer puts slumber on PATH",
            "actually_needed": "Installer installs to ~/.cargo/bin and edits shell profiles; in a non-login shell it is not on PATH until a new shell, so I symlinked it into ~/.local/bin",
            "kind": "note"
          },
          {
            "readme_said": "README example uses shoal.lucaspickering.me",
            "actually_needed": "Checks were pointed at a local python http.server so they replay offline; the POST recipe was checked with --dry-run (http.server rejects POST)",
            "kind": "sandbox"
          },
          {
            "readme_said": "Build requests dynamically from other requests",
            "actually_needed": "response('get') alone fails in the CLI with 'No response available' when there is no history; response('get', trigger='always') was needed",
            "kind": "note"
          },
          {
            "readme_said": "Import from Insomnia",
            "actually_needed": "A minimal handwritten Insomnia v4 JSON export failed with 'No children found for parent `wrk_1`', and an Insomnia v5 YAML file failed with 'missing field `resources`'. No real Insomnia export was available here to test with.",
            "kind": "note"
          }
