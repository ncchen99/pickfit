        },
        {
          "command": "mkdir -p ~/Applications && cp -R ~/mnt/oneasr2/OneAsr.app ~/Applications/",
          "purpose": "copy OneAsr.app to ~/Applications"
        },
        {
          "command": "xattr -cr ~/Applications/OneAsr.app",
          "purpose": "clear quarantine mark with xattr -cr"
        },
        {
          "command": "codesign --force --deep --sign - ~/Applications/OneAsr.app",
          "purpose": "ad-hoc codesign the app"
        },
        {
          "command": "hdiutil detach ~/mnt/oneasr2",
          "purpose": "eject dmg"
        }
      ],
