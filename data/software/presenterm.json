          },
          {
            "readme_said": "Export presentations to PDF",
            "actually_needed": "PDF export needs weasyprint and its system library libpango-1.0-0. `uv tool install weasyprint` worked, but weasyprint cannot load libpango here (it needs apt/root), so presenterm said 'weasyprint not found'",
            "kind": "sandbox"
          }
