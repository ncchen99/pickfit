rint(f\"F3_PREFIX_CACHE_OK matched_blocks={len(matched)} cached_tokens={n_cached} engine_cache_entries={len(engine.prefix_cache.cache) if engine.prefix_cache else 0}\")\ndraft_model = Qwen2ForCausalLM(tiny_cfg(1)).to(device).eval()\nprefix = torch.tensor([[1,2,3,4]], dtype=torch.long)\nnew_tokens, n_acc = speculative_step(target_model=model, draft_model=draft_model, prefix_ids=prefix, k_draft=2, temperature=0.0)\nprint(f\"F4_SPECULATIVE_OK new_tokens={new_tokens} accepted={n_acc}\")\nPY",
