        "pitfalls": [
          {
            "readme_said": "pipx install whisper-local / uv tool install whisper-local on Python 3.11+",
            "actually_needed": "uv tool install --python 3.13 whisper-local (uv auto-downloads CPython 3.13.18); default Homebrew Python 3.15 fails resolving ctranslate2==4.7.1 with no cp315 wheels",
            "kind": "readme_wrong"
          },
          {
            "readme_said": "Install the macOS build (cask or .dmg/.zip) and open the .app",
            "actually_needed": "No Homebrew cask and no macOS .dmg/.zip exist (release v0.23.0 has only whisper-local.exe + PyPI wheel/sdist); on macOS the app is the Python package installed via uv/pipx, not a ~/Applications .app",
            "kind": "note"
          },
          {
            "readme_said": "whisper-local runs the tray app / first-launch welcome window",
            "actually_needed": "Full app launch needs a microphone and Accessibility permission; this VM has neither, so plain launch exits 1 with sounddevice.PortAudioError: Error querying device -1 then a secondary AttributeError in shutdown, and --settings/--cheat-sheet stay alive with no window",
            "kind": "sandbox"
          },
          {
            "readme_said": "whisper-local --doctor Exit 0 = clean",
            "actually_needed": "whisper-local --doctor exits 1 when it finds issues (here: Audio device probe X and Accessibility permission X); README says Exit 0 = clean, so exit 1 is the expected diagnostic signal, not a tool crash",
            "kind": "note"
          }
        ],
