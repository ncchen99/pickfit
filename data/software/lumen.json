        "pitfalls": [
          {
            "readme_said": "curl -fsSL https://servelumen.com/install.sh | bash",
            "actually_needed": "download with curl -fsSL -o /tmp/install.sh, read /tmp/install.sh fully, then run bash /tmp/install.sh",
            "kind": "note"
          },
          {
            "readme_said": "no CUDA SDK needed",
            "actually_needed": "installer auto-fetched NVIDIA NVRTC + cuBLAS 12.9 (670 MB) into ~/.local/lib/lumen because the box has a driver but no CUDA toolkit",
            "kind": "tool_handled"
          },
          {
            "readme_said": "lumen run qwen3.5-9b:q8_0",
            "actually_needed": "used qwen3.5-9b:q4_0 (~5.5 GB LBC) instead of README q8_0; Q4_0 is the smallest quant for the 9B and is verified on T4 cc 7.5",
