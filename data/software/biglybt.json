        },
        {
          "command": "export PATH=/opt/homebrew/opt/openjdk/bin:$PATH && ~/mnt/biglybt/BiglyBT\\ Installer.app/Contents/MacOS/JavaApplicationStub -dir ~/Applications/BiglyBT -q -Dinstall4j.suppressStdout=true -Dinstall4j.debug=false \"-VcreateDesktopLinkAction\\$Boolean=false\" \"-VaddToDockAction\\$Boolean=false\" 2>&1",
