      },
      {
        "feature": "turn filtered assignments back into JSON",
        "title": "Turn filtered assignments back into JSON",
        "steps": [
          "Run `gron <file> | grep <pattern> | grep -v <pattern> | gron --ungron` to keep only the lines you want and rebuild them as JSON."
