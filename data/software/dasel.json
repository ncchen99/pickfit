      {
        "feature": "query multiple data formats with one syntax",
        "title": "Query different data formats with one syntax",
        "steps": [
          "Pipe JSON in and give a selector: `echo '<your json>' | dasel -i json 'foo.bar'`",
          "For YAML, set the input format: `cat <file> | dasel -i yaml 'foo.bar'`"
        ]
      },
      {
        "feature": "extract values from structured data",
        "title": "Extract values from structured data",
        "steps": [
          "Pipe data in, name its format, and give the path to the value: `echo '<your json>' | dasel -i json 'foo.bar'`"
        ]
      },
      {
        "feature": "modify values in structured files",
        "title": "Change values in structured files",
        "steps": [
          "Assign a new value and print the whole document with `--root`: `echo '<your json>' | dasel -i json --root 'foo.bar = \"<new value>\"'`"
        ]
      },
      {
        "feature": "convert between data formats",
        "title": "Convert data from one format to another",
        "steps": [
          "Set the input and output formats: `echo '<your json>' | dasel -i json -o yaml`"
        ]
      }
    ]
