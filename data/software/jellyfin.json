      "items": {
        "what_it_does": {
          "score": 2,
          "quote": "Jellyfin is a Free Software Media System that puts you in control of managing and streaming your media."
        },
        "who_it_is_for": {
          "score": 1,
          "quote": "It is an alternative to the proprietary Emby and Plex, to provide media from a dedicated server to end-user devices via multiple apps."
        },
        "prerequisites": {
          "score": 2,
          "quote": "Before the project can be built, you must first install the [.NET 10 SDK](https://dotnet.microsoft.com/download/dotnet) on your system."
        },
        "install_per_os": {
          "score": 1,
          "quote": "git clone https://github.com/jellyfin/jellyfin.git"
        },
        "first_run_example": {
          "score": 1,
          "quote": "the Web Client can be accessed at `http://localhost:8096` by default."
        },
        "config_and_keys": {
          "score": 1,
          "quote": "switch `--nowebclient` or the environment variable `JELLYFIN_HOSTWEBCLIENT=false`."
        },
