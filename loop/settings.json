{
  "env": {
    "PICKFIT_PIPELINE_DAILY_CAP_USD": "80"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/loop_guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Read(./eval/**)",
      "Read(./.env)",
      "Edit(./eval/**)"
    ]
  }
}
