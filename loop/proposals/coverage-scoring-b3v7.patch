+def readme_snapshot(readme: str = README) -> dict[str, Any]:
+    return {"full_name": "someone/tinyq", "readme": readme, "readme_path": "README.md", "releases": [],
+            "repo": {"full_name": "someone/tinyq", "html_url": "https://github.com/someone/tinyq",
+                     "default_branch": "main"}}
