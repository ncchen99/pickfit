+    q = compose_quality(SEVEN, 10, None, prior=prior, reliability=rel)
+    parts = q["components"]
+    assert parts["feature_results"] == {"score": None, "weight": 20, "reliability": 0.0, "used": prior["feature_results"]}
+    assert parts["responsiveness"]["used"] == prior["responsiveness"] and parts["install_docs"]["used"] == 0.5
+    assert "reliability" not in parts["usage_outcomes"]  # no data yet: it leaves the denominator as before
+    expected = (20 * 1.0 + 20 * prior["feature_results"] + 25 * 0.5 + 10 * 0.5 + 5 * 0.5
+                + 10 * prior["responsiveness"]) / 90
+    assert q["raw_total"] == q["total"] == round(100 * expected, 1)
+    assert q["confidence"] == round((20 + 25 + 10 + 5) / 100, 2)
+    # One broken feature of two weighs 2/3, and a tool nobody tried sits at the mean: between the two.
+    two = {**SEVEN, "feature_results": 0.5}
+    tried = compose_quality(two, 10, None, prior=prior, reliability=reliabilities(two, features=2, issues=None))
+    works = {**SEVEN, "feature_results": 1.0}
+    good = compose_quality(works, 10, None, prior=prior, reliability=reliabilities(works, features=2, issues=None))
+    assert tried["components"]["feature_results"]["used"] == round(2 / 3 * 0.5 + 1 / 3 * prior["feature_results"], 4)
+    assert tried["total"] < q["total"] < good["total"]
