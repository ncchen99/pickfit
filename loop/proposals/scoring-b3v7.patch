@@ -0,0 +1,79 @@
+"""The means b3.v7 pulls a quality component toward when it has little or no data (QUALITY_PRIORS, R6).
+
+docs/proposals/scoring.md R6: a component without data no longer leaves the denominator; it enters as its
+category's mean, and one resting on little data stays close to that mean. This prints, for each category, the
+mean of each component over the scored records that have it (data/software, read only; hosted web apps, scored by
+web.v1, left out), computed as b3.v7 computes it: sandbox_verification and feature_results from the record's runs,
+maintenance, engineering_hygiene and responsiveness from scores.inputs (or, for a record scored before b3.v7, the
+stored component), install_docs as stored. A category with fewer than --min records that have a component gets no
+mean of its own for it; "_all", the mean over every record, takes its place. Paste the output into
+pickfit/score.py; the means are fixed under one formula version, so scores do not drift as records are added.
+
+    uv run python scripts/calibrate_quality_priors.py --data-dir data/software
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+from pickfit.schema import Verification
+from pickfit.score import SHRUNK, feature_score, legacy_inputs, repository_components, sandbox_score
+
+ALL = "_all"
+MIN_RECORDS = 30
+
+
+def components(record: dict[str, Any]) -> dict[str, float | None]:
+    """A record's b3.v7 component scores, before any pull toward a mean."""
+    verification = Verification.model_validate(record["verification"])
+    stored = record["scores"]["quality"]["components"]
+    inputs = record["scores"].get("inputs") or legacy_inputs(stored)
+    repo, _, _ = repository_components(inputs, open_source=record.get("open_source"), security=record.get("security"))
+    return {"sandbox_verification": sandbox_score(verification), "feature_results": feature_score(verification),
+            "install_docs": (stored.get("install_docs") or {}).get("score"), **repo}
+
+
+def priors(data_dir: Path, min_records: int = MIN_RECORDS) -> tuple[dict[str, dict[str, float]], dict[str, Any]]:
+    """QUALITY_PRIORS, and the counts behind each mean."""
+    by_category: dict[str, list[dict[str, float | None]]] = {}
+    for path in sorted(data_dir.glob("*.json")):
+        record = json.loads(path.read_text(encoding="utf-8"))
+        if not record.get("scores") or record.get("kind") == "web_app":
+            continue
+        by_category.setdefault(record["category"], []).append(components(record))
+    pooled = [c for rows in by_category.values() for c in rows]
+    out: dict[str, dict[str, float]] = {}
+    counts: dict[str, Any] = {}
+    for category, rows in [(ALL, pooled), *sorted(by_category.items())]:
+        means, have = {}, {}
+        for name in SHRUNK:
+            values = [c[name] for c in rows if c[name] is not None]
+            have[name] = len(values)
+            if values and (category == ALL or len(values) >= min_records):
+                means[name] = round(sum(values) / len(values), 4)
+        counts[category] = {"records": len(rows), "with": have}
+        if means:
+            out[category] = means
+    return out, counts
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--data-dir", default="data/software")
+    parser.add_argument("--min", type=int, default=MIN_RECORDS,
+                        help=f"fewest records with a component for a category's own mean (default {MIN_RECORDS})")
+    args = parser.parse_args(argv)
+    means, counts = priors(Path(args.data_dir), args.min)
+    for category, count in counts.items():
+        print(f"{category}: {count['records']} records; with each component: "
+              + ", ".join(f"{k} {v}" for k, v in count["with"].items()), file=sys.stderr)
+    print(json.dumps(means, indent=4))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
