+# The levels of security.assessment.level (sec.v2, docs/proposals/security.md S5), most severe first. What each does
+# to scores (pickfit/score.py security_effect): blocked is not listed and exposed loses points, neither can be a
+# treasure; conditional gets a line on the page; present_unreachable and not_shipped change nothing; partial and
+# unchecked are "not verified". A check written before assessments (sec.v1) has none: it keeps the known_vulnerability
+# cap until it is checked again.
+SECURITY_LEVELS: tuple[str, ...] = (
+    "blocked", "exposed", "conditional", "present_unreachable", "not_shipped", "clean", "partial", "unchecked",
+)
+# R9 of docs/proposals/scoring.md, for 念誠 to decide. True keeps today's rule: a record whose security could not be
+# checked (unchecked or partial) can be a treasure, and its page says it was not checked. False takes the treasure
+# away until it is checked. Changing it needs `pickfit score --refresh` over the records.
+UNCHECKED_CAN_BE_TREASURE = True
+type TreasureBlock = Literal["security_blocked", "security_exposed", "security_unchecked"]
+
+
+def _field(value: Any, name: str) -> Any:
+    if value is None:
+        return None
+    return value.get(name) if isinstance(value, dict) else getattr(value, name, None)
+
+
+def security_level(security: Any) -> str | None:
+    """security.assessment.level (model or JSON); None for a check without an assessment (sec.v1) or no check."""
+    level = _field(_field(security, "assessment"), "level")
+    return level if level in SECURITY_LEVELS else None
+
+
+def security_status_level(security: Any) -> str:
+    """The level scores act on: the assessment's, else the sec.v1 status (vulnerable, clean or unchecked); a record
+    with no check is unchecked."""
+    level = security_level(security)
+    if level is not None:
+        return level
+    status = _field(security, "status")
+    return status if status in ("vulnerable", "clean", "unchecked") else "unchecked"
+
+
 def security_vulnerable(security: Any) -> bool:
-    """Whether a record's security check (model or its JSON) found a high or critical advisory."""
-    if security is None:
+    """Whether the sec.v1 rule caps the record at 79: a high or critical advisory and no assessment yet. A check with
+    an assessment is scored by its level instead (security_level, treasure_block)."""
+    if security is None or security_level(security) is not None:
         return False
-    status = security.get("status") if isinstance(security, dict) else security.status
-    return status == "vulnerable"
+    return _field(security, "status") == "vulnerable"
+
+
+def treasure_block(security: Any) -> TreasureBlock | None:
+    """Why a record cannot be a treasure whatever its scores, or None: blocked or exposed by its assessment, or not
+    checked while UNCHECKED_CAN_BE_TREASURE is off (R9)."""
+    level = security_status_level(security)
+    if level == "blocked":
+        return "security_blocked"
+    if level == "exposed":
+        return "security_exposed"
+    if level in ("unchecked", "partial") and not UNCHECKED_CAN_BE_TREASURE:
+        return "security_unchecked"
+    return None
 
 
