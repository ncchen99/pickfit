+"""Formula b3.v7 (docs/proposals/scoring.md): stored inputs, rubric versions and reuse, the security level, pulling
+toward the category's mean, the run's depth, history, and the migration and recompute scripts; no network."""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime, timedelta
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+from test_extract import FakeMeta, ok
+from test_profiles import MODEL, README, add, extraction
+from test_score import LATER, NOW, fake_grade, issue, items, run, setup_records, verification
+
+import pickfit.env
+from pickfit import extract, meta, schema
+from pickfit import score as score_module
+from pickfit.discover.store import PipelineDB
+from pickfit.extract import build_sources, input_sha, sources_sha
+from pickfit.ledger import Caps, Ledger
+from pickfit.schema import DocsRubric, DocsRubricItems, Scores, SoftwareRecord, treasure_block
+from pickfit.score import (
+    FORMULA_VERSION,
+    HISTORY_KEPT,
+    MCP_HANDSHAKE_DEPTH,
+    QUALITY_PRIORS,
+    SECURITY_EXPOSED_DEDUCTION,
+    STALE_FIX_PENALTY,
+    compose_quality,
+    features_judged,
+    github_inputs,
+    hygiene_from_inputs,
+    hygiene_score,
+    issue_inputs,
+    maintenance_penalty,
+    maintenance_score,
+    quality_priors,
+    refresh_scores,
+    reliabilities,
+    remember,
+    repository_components,
+    responsiveness_detail,
+    rubric_reuse,
+    run_depth,
+    score_records,
+    security_effect,
+    snapshot_time,
+    stale_fixes,
+    treasure,
+)
+
+
+@pytest.fixture(autouse=True)
+def isolated(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(pickfit.env, "DOTENV_PATH", tmp_path / "missing.env")
+    for name in ("PICKFIT_MODE", "PICKFIT_CACHE", "MODEL_API_KEY"):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setenv("PICKFIT_LEDGER", str(tmp_path / "default-ledger.sqlite"))
+    monkeypatch.setenv("PICKFIT_RUNS_DIR", str(tmp_path / "runs"))
+    monkeypatch.setattr(meta, "sleep", lambda s: None)
+
+
+def scored(tmp_path: Path, **kwargs: Any) -> tuple[Path, Path, dict[str, Any]]:
+    db_path, out = setup_records(tmp_path, **kwargs)
+    score_records(out, db_path=db_path, model=MODEL, use_github=False, use_registries=False, now=NOW,
+                  grade=fake_grade())
+    return db_path, out, json.loads((out / "tinyq.json").read_text(encoding="utf-8"))
+
+
+SEVEN = {"sandbox_verification": 1.0, "feature_results": None, "install_docs": 0.5, "maintenance": 0.5,
+         "engineering_hygiene": 0.5, "responsiveness": None, "usage_outcomes": None}
+
+
+# --- R7: how far the run got --------------------------------------------------------------------------------------
+
+
+def test_installing_alone_counts_less_than_a_checked_feature_and_a_handshake_less_than_a_tool_call() -> None:
+    assert run_depth(SimpleNamespace(level="install", mcp=None)) == 0.8
+    assert run_depth(SimpleNamespace(level="function", mcp=None)) == 1.0  # as far as a command-line tool goes
+    assert run_depth(SimpleNamespace(level="function", mcp=object())) == MCP_HANDSHAKE_DEPTH  # handshake only
+    assert run_depth(SimpleNamespace(level="service", mcp=object())) == 1.0  # a tool call returned
+
+
+# --- R6: little or no data pulls toward the category's mean --------------------------------------------------------
+
