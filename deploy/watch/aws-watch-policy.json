{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInTaipei",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-east-2"}}
    },
    {
      "Sid": "CreateOnlyTaggedPickfitResources",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances", "ec2:CreateImage", "ec2:CreateSecurityGroup"],
      "Resource": [
        "arn:aws:ec2:ap-east-2:*:instance/*",
        "arn:aws:ec2:ap-east-2:*:volume/*",
        "arn:aws:ec2:ap-east-2:*:security-group/*",
        "arn:aws:ec2:ap-east-2::image/*",
        "arn:aws:ec2:ap-east-2::snapshot/*"
      ],
      "Condition": {"StringEquals": {"aws:RequestTag/pickfit": "verify"}}
    },
    {
      "Sid": "LaunchFromImagesInTheDefaultNetwork",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances", "ec2:CreateSecurityGroup"],
      "Resource": [
        "arn:aws:ec2:ap-east-2::image/*",
        "arn:aws:ec2:ap-east-2::snapshot/*",
        "arn:aws:ec2:ap-east-2:*:subnet/*",
        "arn:aws:ec2:ap-east-2:*:network-interface/*",
        "arn:aws:ec2:ap-east-2:*:security-group/*",
        "arn:aws:ec2:ap-east-2:*:vpc/*",
        "arn:aws:ec2:ap-east-2:*:key-pair/*"
      ]
    },
    {
      "Sid": "TagWhileCreating",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {"StringEquals": {"ec2:CreateAction": ["RunInstances", "CreateImage", "CreateSecurityGroup"]}}
    },
    {
      "Sid": "ManageOnlyPickfitResources",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:StartInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:CreateTags",
        "ec2:CreateImage",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:ResourceTag/pickfit": "verify", "aws:RequestedRegion": "ap-east-2"}}
    }
  ]
}
