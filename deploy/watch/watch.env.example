# /etc/pickfit/watch.env for the pickfit-watch service: names only, fill in the values on the machine itself
# (root:pickfit 0640). Nothing here is ever committed.

# Models (prescreen, extraction, verification, judges, translation).
ANTHROPIC_API_KEY=

# Linux boxes and the web lane's browser VMs.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# The Worker's D1 (submissions, statuses) through wrangler. The token needs D1 edit on this account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub: reading repositories (any read-only token), and pushing record commits to main (a fine-grained token
# with Contents: read and write on ncchen99/pickfit only).
GH_TOKEN=
GH_PUSH_TOKEN=

# The Windows lane (EC2 in Taipei). Leave empty to let that lane wait; an IAM user limited to the EC2 calls
# pickfit makes is enough.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PICKFIT_EC2_REGION=ap-east-2

# The macOS lane renting Macs (only with --mac-rent in the service's ExecStart). Project "Pickfit".
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_PROJECT_ID=
SCW_DEFAULT_ZONE=fr-par-1

# The model budget's daily cap, as on the laptop (loop/settings.json).
PICKFIT_PIPELINE_DAILY_CAP_USD=80

# pickfit harvest (deploy/watch/pickfit-harvest*.timer). Optional social sources; leave empty to skip them.
# Bluesky: an app password (Settings > Privacy and security > App passwords), free.
BSKY_HANDLE=
BSKY_APP_PASSWORD=
# X API v2, pay per use ($0.005 a post read; each run reads at most --x-max-reads, default 100).
X_BEARER_TOKEN=
# e.g. "--source mcp_registry --source hn"; empty runs the default sources plus Bluesky and X when keyed.
HARVEST_SOURCES=
HARVEST_FEED_PER_HOUR=10

# Watch throughput (11/19, docs/proposals/throughput.md). Leave a line empty for its default; a flag in the service's
# ExecStart wins over it. `pickfit watch --status` shows what each lane runs and why it starts nothing new.
# Repository submissions read and verified on Modal at once (Modal held 8; this VM is small, so 6).
PICKFIT_WATCH_LINUX_CONCURRENCY=
# Website submissions at once (default 2: reading a site drawn by script starts a local Chromium).
PICKFIT_WATCH_WEB_CONCURRENCY=
# EC2 Windows boxes at once (default 2, never more: the account's 8 vCPU quota holds two).
PICKFIT_WATCH_WINDOWS_CONCURRENCY=
# Model spend allowed in any rolling 24 hours, as the ledger counts it (default: loop/budget.json's model_usd.daily,
# 80 since 11/15). Keep it at or under PICKFIT_PIPELINE_DAILY_CAP_USD.
PICKFIT_WATCH_DAILY_USD=
# Harvest rows (ids starting sub_harvest) wait behind people's submissions: at most this many at once in all lanes
# (default 4), one slot of each lane left to people, and this much of the 24 h money kept for them (default 10).
PICKFIT_WATCH_HARVEST_SLOTS=
PICKFIT_WATCH_USER_RESERVE_USD=
# At most this many submissions start in a rolling hour (default 0: none; the Worker's SUBMIT_HOURLY_CAP caps intake).
PICKFIT_WATCH_HOURLY_CAP=
