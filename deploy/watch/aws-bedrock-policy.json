{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeThroughTheGlobalProfilesFromTaipei",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:ap-east-2:*:inference-profile/global.anthropic.claude-opus-5-5",
        "arn:aws:bedrock:ap-east-2:*:inference-profile/global.anthropic.claude-haiku-5-5"
      ],
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-east-2"}}
    },
    {
      "Sid": "TheModelsBehindThoseProfilesInTaipei",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:ap-east-2::foundation-model/anthropic.claude-opus-5-5",
        "arn:aws:bedrock:ap-east-2::foundation-model/anthropic.claude-haiku-5-5"
      ],
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "ap-east-2"},
        "StringLike": {
          "bedrock:InferenceProfileArn": [
            "arn:aws:bedrock:ap-east-2:*:inference-profile/global.anthropic.claude-opus-5-5",
            "arn:aws:bedrock:ap-east-2:*:inference-profile/global.anthropic.claude-haiku-5-5"
          ]
        }
      }
    },
    {
      "Sid": "TheSameModelsWhereverTheProfilesRoute",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:::foundation-model/anthropic.claude-opus-5-5",
        "arn:aws:bedrock:::foundation-model/anthropic.claude-haiku-5-5"
      ],
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "unspecified"},
        "StringLike": {
          "bedrock:InferenceProfileArn": [
            "arn:aws:bedrock:ap-east-2:*:inference-profile/global.anthropic.claude-opus-5-5",
            "arn:aws:bedrock:ap-east-2:*:inference-profile/global.anthropic.claude-haiku-5-5"
          ]
        }
      }
    }
  ]
}
