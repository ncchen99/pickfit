{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeThroughTheGlobalProfilesFromVirginia",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:us-east-1:*:inference-profile/global.anthropic.claude-opus-5-5",
        "arn:aws:bedrock:us-east-1:*:inference-profile/global.anthropic.claude-haiku-5-5"
      ],
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "TheModelsBehindThoseProfilesInVirginia",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-opus-5-5",
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-haiku-5-5"
      ],
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "us-east-1"},
        "StringLike": {
          "bedrock:InferenceProfileArn": [
            "arn:aws:bedrock:us-east-1:*:inference-profile/global.anthropic.claude-opus-5-5",
            "arn:aws:bedrock:us-east-1:*:inference-profile/global.anthropic.claude-haiku-5-5"
          ]
        }
      }
    },
    {
      "Sid": "TheSameModelsWhereverTheProfilesRoute",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:::foundation-model/anthropic.claude-opus-5-5",
        "arn:aws:bedrock:::foundation-model/anthropic.claude-haiku-5-5"
      ],
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "unspecified"},
        "StringLike": {
          "bedrock:InferenceProfileArn": [
            "arn:aws:bedrock:us-east-1:*:inference-profile/global.anthropic.claude-opus-5-5",
            "arn:aws:bedrock:us-east-1:*:inference-profile/global.anthropic.claude-haiku-5-5"
          ]
        }
      }
    }
  ]
}
