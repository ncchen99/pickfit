# pickfit maintenance reverify (F3): up to REVERIFY_LIMIT (default 3) reported install failures re-verified in a fresh
# box. PAID: each is a sandbox run with the model (about the cost of one verification), under the same daily money
# check as the watch. It rewrites a record's steps from a user's report, so it commits on maint/reverify-YYYYMMDD and
# pushes that branch for a person to read; never main. Installed by bootstrap.sh, enabled by a person.
[Unit]
Description=pickfit reverify queue (paid; commits to a review branch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pickfit
Group=pickfit
WorkingDirectory=/var/lib/pickfit/pickfit
EnvironmentFile=/etc/pickfit/watch.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p runs/maintenance
ExecStart=/bin/sh -c '/usr/local/bin/uv run pickfit maintenance reverify --limit $${REVERIFY_LIMIT:-3} > runs/maintenance/reverify.json'
TimeoutStartSec=3h
Nice=10
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
