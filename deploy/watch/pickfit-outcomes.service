# pickfit maintenance outcomes (F4): outside report_outcome counts from D1 (read-only) into data/software's scores,
# in the maintenance worktree, committed and pushed to main; CI deploys it. No model call. Needs the D1 credentials
# watch.env already holds for the watch. Installed by bootstrap.sh, enabled by a person.
[Unit]
Description=pickfit outcomes sync from D1 (no model cost)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pickfit
Group=pickfit
WorkingDirectory=/var/lib/pickfit/pickfit
EnvironmentFile=/etc/pickfit/watch.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p runs/maintenance
ExecStart=/bin/sh -c '/usr/local/bin/uv run pickfit maintenance outcomes > runs/maintenance/outcomes.json'
TimeoutStartSec=30m
Nice=10
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
